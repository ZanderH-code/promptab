{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.12.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "unlimitedStorage", "favicon"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; font-src 'self' data: blob:"
  }
}
