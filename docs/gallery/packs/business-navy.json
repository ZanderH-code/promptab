{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Business Navy",
    "author": "Promptab",
    "tags": [
      "dark",
      "business"
    ],
    "prompt": {
      "en": "A composed navy workspace with a compact overview and an orderly list of links.",
      "zh-CN": "沉稳的海军蓝工作台，顶部简洁概览，书签整齐排列。"
    }
  },
  "theme": {
    "mode": "dark",
    "color": {
      "bg": "#101a2c",
      "surface": "#1a2940",
      "text": "#f3f7ff",
      "accent": "#a8caff"
    },
    "font": {
      "display": "system",
      "ui": "system"
    },
    "radius": 8,
    "shadow": 25,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "rounded"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 160,
      "stops": [
        "#101a2c",
        "#172d48"
      ]
    }
  },
  "layout": {
    "areas": [
      "bookmarks overview"
    ],
    "columns": [
      "minmax(0, 1fr)",
      "minmax(280px, 0.7fr)"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 1100,
    "align": "top-left",
    "gap": 20
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "left",
        "hour12": false,
        "size": 1
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "left"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "list",
        "maxColumns": 3,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ]
}
