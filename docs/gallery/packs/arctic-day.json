{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Arctic Day",
    "author": "Promptab",
    "tags": [
      "light",
      "arctic"
    ],
    "prompt": {
      "en": "A clear winter morning: pale ice, generous space, and a crisp blue clock above your links.",
      "zh-CN": "清亮的冬日早晨：冰白底色、宽松留白和蓝色时钟，书签放在下方。"
    }
  },
  "theme": {
    "mode": "light",
    "color": {
      "bg": "#10141b",
      "surface": "#161b22",
      "text": "#ffffff",
      "accent": "#a8f0db"
    },
    "colorLight": {
      "bg": "#eaf4f6",
      "surface": "#f8fdff",
      "text": "#19313b",
      "accent": "#225269"
    },
    "font": {
      "display": "system",
      "ui": "system"
    },
    "radius": 14,
    "shadow": 10,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "rounded"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 145,
      "stops": [
        "#eaf4f6",
        "#d5e9ee"
      ]
    }
  },
  "layout": {
    "areas": [
      "overview overview",
      "bookmarks bookmarks"
    ],
    "columns": [
      "1fr",
      "1fr"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 960,
    "align": "center-center",
    "gap": 24
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 1.1
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "tile",
        "maxColumns": 5,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ]
}
