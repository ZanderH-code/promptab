{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Arctic Day",
    "author": "Promptab",
    "tags": [
      "light",
      "arctic"
    ],
    "prompt": {
      "en": "Create a arctic-inspired light new tab with legible colors and matching typography.",
      "zh-CN": "创建以极地为灵感的浅色新标签页，搭配清晰配色与合适的字体。"
    }
