{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Natural Moss",
    "author": "Promptab",
    "tags": [
      "light",
      "nature"
    ],
    "prompt": {
      "en": "A soft moss and cream page with an airy clock and a garden of rounded bookmarks.",
      "zh-CN": "苔绿与奶油色搭配，时钟轻盈舒展，圆角书签如同一座小花园。"
    }
  },
  "theme": {
    "mode": "light",
    "color": {
      "bg": "#10141b",
      "surface": "#161b22",
      "text": "#ffffff",
      "accent": "#a8f0db"
    },
    "colorLight": {
      "bg": "#eef3e6",
      "surface": "#f8fbf3",
      "text": "#1e3020",
      "accent": "#315d31"
    },
    "font": {
      "display": "serif",
      "ui": "system"
    },
    "radius": 20,
    "shadow": 10,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "rounded"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 150,
      "stops": [
        "#eef3e6",
        "#dce9d5"
      ]
    }
  },
  "layout": {
    "areas": [
      "overview",
      "bookmarks"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ]
      }
    },
    "contentWidth": 1050,
    "align": "center-center",
    "gap": 28
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 1
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "card",
        "maxColumns": 4,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ]
}
