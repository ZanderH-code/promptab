{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Paper Notes",
    "author": "Promptab",
    "tags": [
      "light",
      "paper"
    ],
    "prompt": {
      "en": "A warm paper notebook with a serif heading, fine rules, and a practical list of bookmarks.",
      "zh-CN": "暖纸色笔记本，衬线标题与细线条搭配，书签以实用列表呈现。"
    }
  },
  "theme": {
    "mode": "light",
    "color": {
      "bg": "#10141b",
      "surface": "#161b22",
      "text": "#ffffff",
      "accent": "#a8f0db"
    },
    "colorLight": {
      "bg": "#f7f4e9",
      "surface": "#fffdf5",
      "text": "#29261f",
      "accent": "#58411d"
    },
    "font": {
      "display": "serif",
      "ui": "system"
    },
    "radius": 3,
    "shadow": 10,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "square"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 115,
      "stops": [
        "#f7f4e9",
        "#eee5ce"
      ]
    }
  },
  "layout": {
    "areas": [
      "bookmarks overview"
    ],
    "columns": [
      "minmax(0, 1fr)",
      "minmax(280px, 0.7fr)"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 1000,
    "align": "top-left",
    "gap": 22
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "left",
        "hour12": false,
        "size": 0.9
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "left"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "list",
        "maxColumns": 2,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-group-title { letter-spacing: 0.08em; text-transform: uppercase; }\n.mnt-link { border-bottom: 1px solid var(--mnt-border); }"
}
