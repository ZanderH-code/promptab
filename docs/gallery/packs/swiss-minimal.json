{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Swiss Minimal",
    "author": "Promptab",
    "tags": [
      "light",
      "swiss"
    ],
    "prompt": {
      "en": "A Swiss-inspired editorial layout in white and red, with bold alignment and minimal bookmarks.",
      "zh-CN": "瑞士平面设计风格的黑白红页面，强调对齐，书签简洁明快。"
    }
  },
  "theme": {
    "mode": "light",
    "color": {
      "bg": "#10141b",
      "surface": "#161b22",
      "text": "#ffffff",
      "accent": "#a8f0db"
    },
    "colorLight": {
      "bg": "#f5f5f2",
      "surface": "#ffffff",
      "text": "#151515",
      "accent": "#a5241a"
    },
    "font": {
      "display": "outfit",
      "ui": "system"
    },
    "radius": 0,
    "shadow": 10,
    "glass": 0,
    "density": "compact",
    "iconShape": "square"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 90,
      "stops": [
        "#f5f5f2",
        "#e9e9e4"
      ]
    }
  },
  "layout": {
    "areas": [
      "overview overview",
      "bookmarks bookmarks"
    ],
    "columns": [
      "1fr",
      "1fr"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 1200,
    "align": "top-left",
    "gap": 16
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "left",
        "hour12": false,
        "size": 1.2
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "left"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "minimal",
        "maxColumns": 3,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-clock { letter-spacing: -0.04em; }\n.mnt-group-title { text-transform: uppercase; letter-spacing: 0.12em; }"
}
