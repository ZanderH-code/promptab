{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Indigo Ink",
    "author": "Promptab",
    "tags": [
      "dark",
      "indigo"
    ],
    "prompt": {
      "en": "An indigo writing desk with monospaced time, quiet dividers, and room for useful links.",
      "zh-CN": "靛蓝色书桌，等宽字体显示时间，细分隔线旁留出书签空间。"
    }
  },
  "theme": {
    "mode": "dark",
    "color": {
      "bg": "#14182a",
      "surface": "#202640",
      "text": "#f7f8ff",
      "accent": "#cdd9ff"
    },
    "font": {
      "display": "mono",
      "ui": "mono"
    },
    "radius": 10,
    "shadow": 25,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "rounded"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 120,
      "stops": [
        "#14182a",
        "#25264c"
      ]
    }
  },
  "layout": {
    "areas": [
      "bookmarks overview"
    ],
    "columns": [
      "minmax(0, 1fr)",
      "minmax(280px, 0.7fr)"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 1000,
    "align": "center-left",
    "gap": 24
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 1.1
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "minimal",
        "maxColumns": 3,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-date { letter-spacing: 0.12em; text-transform: uppercase; }\n.mnt-link { border-bottom: 1px solid var(--mnt-border); }"
}
