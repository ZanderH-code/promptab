{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Deep Current",
    "author": "Promptab",
    "tags": [
      "dark",
      "ocean",
      "dashboard"
    ],
    "prompt": {
      "en": "Design a deep-water dashboard with a calm slab-serif clock, sea-glass accents, and aligned daily cards.",
      "zh-CN": "设计深海色仪表板，以沉静的衬线时钟、海玻璃点缀和对齐的每日卡片呈现。"
    }
  },
  "theme": {
    "mode": "dark",
    "color": {
      "bg": "#101d26",
      "surface": "#1c303a",
      "text": "#f0f8fa",
      "accent": "#8ad8df"
    },
    "font": {
      "display": "serif",
      "ui": "system"
    },
    "radius": 16,
    "shadow": 22,
    "glass": 8,
    "density": "comfortable",
    "iconShape": "circle"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 155,
      "stops": [
        "#101d26",
        "#183d49"
      ]
    }
  },
  "layout": {
    "areas": [
      "overview overview overview",
      "bookmarks bookmarks bookmarks"
    ],
    "columns": [
      "minmax(0, 1fr)",
      "minmax(0, 1fr)",
      "minmax(0, 1fr)"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "contentWidth": 1120,
    "align": "top-center",
    "gap": 24
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "hour12": false,
        "size": 1.4
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "card",
        "maxColumns": 4,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-weather { border-radius: 16px; }\n.mnt-widget-frame { letter-spacing: 0.01em; }"
}
