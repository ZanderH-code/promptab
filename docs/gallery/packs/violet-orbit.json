{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Violet Orbit",
    "author": "Promptab",
    "tags": [
      "dark",
      "space"
    ],
    "prompt": {
      "en": "A violet night sky with a rounded clock and small, bright shortcut tiles.",
      "zh-CN": "紫罗兰夜空下，圆润的时钟与明亮的小型书签卡片相伴。"
    }
  },
  "theme": {
    "mode": "dark",
    "color": {
      "bg": "#181429",
      "surface": "#242039",
      "text": "#faf8ff",
      "accent": "#d9ccff"
    },
    "font": {
      "display": "outfit",
      "ui": "system"
    },
    "radius": 20,
    "shadow": 25,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "circle"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 135,
      "stops": [
        "#181429",
        "#30234d"
      ]
    }
  },
  "layout": {
    "areas": [
      "bookmarks divider overview"
    ],
    "columns": [
      "minmax(0, 1fr)",
      "1px",
      "minmax(280px, 0.7fr)"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "overview",
          "bookmarks"
        ],
        "columns": [
          "1fr"
        ]
      }
    },
    "areaStyles": {
      "divider": {
        "background": "accent"
      }
    },
    "contentWidth": 1000,
    "align": "center-center",
    "gap": 28
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "overview",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 1.1
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "overview",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "overview",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "bookmarks",
      "order": 3,
      "props": {
        "style": "icon-only",
        "maxColumns": 3,
        "showGroupTitles": true,
        "showAdd": true,
        "iconColor": "accent"
      }
    }
  ],
  "css": ".mnt-link-icon { box-shadow: 0 0 var(--orbit-glow, 10px) var(--mnt-accent-soft); }",
  "variables": [
    {
      "name": "--orbit-glow",
      "label": {
        "en": "Glow radius",
        "zh-CN": "光晕半径"
      },
      "type": "range",
      "min": 0,
      "max": 24,
      "unit": "px",
      "default": 10
    }
  ]
}
