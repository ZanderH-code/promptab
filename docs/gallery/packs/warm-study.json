{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Warm Study",
    "author": "Promptab",
    "tags": [
      "light",
      "study"
    ],
    "prompt": {
      "en": "An amber-lit study with literary type, warm paper tones, and your favorite sites close at hand.",
      "zh-CN": "琥珀灯光下的书房，文字带有书卷气，暖纸色背景衬托常用网站。"
    }
  },
  "theme": {
    "mode": "light",
    "color": {
      "bg": "#10141b",
      "surface": "#161b22",
      "text": "#ffffff",
      "accent": "#a8f0db"
    },
    "colorLight": {
      "bg": "#f4ead7",
      "surface": "#fff6e6",
      "text": "#352519",
      "accent": "#72451d"
    },
    "font": {
      "display": "cormorant",
      "ui": "system"
    },
    "radius": 6,
    "shadow": 10,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "rounded"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 125,
      "stops": [
        "#f4ead7",
        "#ead6b8"
      ]
    }
  },
  "layout": {
    "areas": [
      ".",
      "banner",
      "websites"
    ],
    "columns": [
      "1fr"
    ],
    "rows": [
      "4vh",
      "auto",
      "1fr"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "banner",
          "websites"
        ],
        "columns": [
          "1fr"
        ],
        "rows": [
          "auto",
          "1fr"
        ]
      }
    },
    "areaStyles": {
      "banner": {
        "background": "surface",
        "opacity": 85,
        "padding": 24,
        "align": "center-right",
        "border": {
          "bottom": 1
        }
      }
    },
    "contentWidth": 1050,
    "align": "center-left",
    "gap": 16
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "banner",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 2.4
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "banner",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "websites",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "websites",
      "order": 3,
      "props": {
        "style": "card",
        "maxColumns": 4,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-date { letter-spacing: 0.1em; }\n.mnt-search { margin-top: 0px; }\n.mnt-link { border-bottom: 1px solid var(--mnt-border); }"
}
