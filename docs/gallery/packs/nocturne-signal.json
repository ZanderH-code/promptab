{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {"name": "Nocturne Signal", "author": "Promptab", "tags": ["dark", "signal", "icon-split"], "prompt": {"en": "Build a midnight signal desk with a crisp mono clock, teal markers, and a quiet icon rail.", "zh-CN": "打造午夜信号桌面，以清晰的等宽时钟、青绿色标记和安静的图标栏呈现。"}},
  "theme": {"mode": "dark", "color": {"bg": "#101923", "surface": "#1c2b35", "text": "#f3f8f8", "accent": "#72e0cf"}, "font": {"display": "mono", "ui": "outfit"}, "radius": 12, "shadow": 24, "glass": 8, "density": "comfortable", "iconShape": "square"},
  "background": {"type": "gradient", "gradient": {"angle": 135, "stops": ["#101923", "#173c45"]}},
  "layout": {"areas": ["bookmarks divider overview"], "columns": ["minmax(0, 1fr)", "1px", "minmax(280px, 0.7fr)"], "breakpoints": {"narrow": {"areas": ["overview", "bookmarks"], "columns": ["1fr"]}}, "areaStyles": {"divider": {"background": "accent"}}, "contentWidth": 1080, "align": "center-center", "gap": 28},
  "widgets": [{"id": "clock", "type": "clock", "area": "overview", "order": 0, "props": {"hour12": false, "size": 1.2}}, {"id": "date", "type": "date", "area": "overview", "order": 1, "props": {"format": "full"}}, {"id": "search", "type": "search", "area": "overview", "order": 2, "props": {}}, {"id": "bookmarks", "type": "bookmarks", "area": "bookmarks", "order": 3, "props": {"style": "icon-only", "maxColumns": 3, "showAdd": true}}],
  "css": ".mnt-clock { letter-spacing: 0.08em; }\n.mnt-group-title { text-transform: uppercase; letter-spacing: 0.14em; }"
}
