{
  "kind": "mnt.theme-pack",
  "packVersion": 2,
  "cssApiVersion": 1,
  "meta": {
    "name": "Plum Night",
    "author": "Promptab",
    "tags": [
      "dark",
      "plum"
    ],
    "prompt": {
      "en": "A quiet plum evening with elegant type, soft corners, and a centered collection of links.",
      "zh-CN": "安静的梅紫夜色，搭配优雅字体、柔和圆角和居中的书签。"
    }
  },
  "theme": {
    "mode": "dark",
    "color": {
      "bg": "#211422",
      "surface": "#301d30",
      "text": "#fff7ff",
      "accent": "#f5c6ee"
    },
    "font": {
      "display": "cormorant",
      "ui": "system"
    },
    "radius": 24,
    "shadow": 25,
    "glass": 0,
    "density": "comfortable",
    "iconShape": "circle"
  },
  "background": {
    "type": "gradient",
    "gradient": {
      "angle": 145,
      "stops": [
        "#211422",
        "#42233e"
      ]
    }
  },
  "layout": {
    "areas": [
      ".",
      "banner",
      "websites"
    ],
    "columns": [
      "1fr"
    ],
    "rows": [
      "4vh",
      "auto",
      "1fr"
    ],
    "breakpoints": {
      "narrow": {
        "areas": [
          "banner",
          "websites"
        ],
        "columns": [
          "1fr"
        ],
        "rows": [
          "auto",
          "1fr"
        ]
      }
    },
    "areaStyles": {
      "banner": {
        "background": "surface",
        "opacity": 85,
        "padding": 24,
        "align": "center-right",
        "border": {
          "bottom": 1
        }
      }
    },
    "contentWidth": 960,
    "align": "center-center",
    "gap": 16
  },
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "area": "banner",
      "order": 0,
      "props": {
        "align": "center",
        "hour12": false,
        "size": 2.4
      }
    },
    {
      "id": "date",
      "type": "date",
      "area": "banner",
      "order": 1,
      "props": {
        "format": "full",
        "align": "center"
      }
    },
    {
      "id": "search",
      "type": "search",
      "area": "websites",
      "order": 2,
      "props": {}
    },
    {
      "id": "bookmarks",
      "type": "bookmarks",
      "area": "websites",
      "order": 3,
      "props": {
        "style": "card",
        "maxColumns": 4,
        "showGroupTitles": true,
        "showAdd": true
      }
    }
  ],
  "css": ".mnt-search { margin-top: 28px; }"
}
